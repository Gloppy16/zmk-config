#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE      0
#define LOWER     1
#define RAISE     2
#define TRACKBALL 3

/ {
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_0>;
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
            /*  left                                                              right                                    */
                &kp TAB    &kp Q   &kp W   &kp E   &kp R    &kp T     &kp Y     &kp U     &kp I      &kp O    &kp P     &kp BSPC
                &kp LCTRL  &kp A   &kp S   &kp D   &kp F    &kp G     &kp H     &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
                &kp LSHFT  &kp Z   &kp X   &kp C   &kp V    &kp B     &kp N     &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp MINUS
                &kp LGUI   &mt LALT DEL     &lt LOWER INT5   &kp SPACE &mkp LCLK &mkp RCLK &kp ENTER  &lt RAISE INT4     &kp BSPC  &kp ESC
            >;
            sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
                &kp ESC    &kp EXCL &kp AT    &kp HASH &kp DLLR  &kp PRCNT  &kp CARET &kp AMPS   &kp ASTRK &kp LPAR   &kp RPAR  &kp BSPC
                &kp LCTRL  &none    &none     &none    &none     &none      &kp LBRC  &kp RBRC   &kp LBKT  &kp RBKT   &kp COLON &kp DQT
                &kp LSHFT  &kp GRAVE &kp TILDE &kp NUBS &kp PIPE &none      &kp EQL   &kp PLUS   &kp LT    &kp GT     &kp QMARK &kp UNDER
                &kp LGUI   &mt LALT DEL      &trans      &kp SPACE &mkp MB4  &mkp MB5  &kp ENTER  &tog TRACKBALL &kp BSPC &kp ESC
            >;
            sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
                &kp ESC    &kp N1   &kp N2    &kp N3   &kp N4    &kp N5     &kp N6    &kp N7     &kp N8     &kp N9    &kp N0    &kp BSPC
                &kp LCTRL  &kp F1   &kp F2    &kp F3   &kp F4    &kp F5     &kp K_APP &kp UP     &kp LS(INT1) &kp UNDER &kp DQT &kp COLON
                &kp LSHFT  &kp F6   &kp F7    &kp F8   &kp F9    &kp F10    &kp LEFT  &kp DOWN   &kp RIGHT  &kp DOT   &kp FSLH  &kp MINUS
                &kp LGUI   &mt LALT DEL      &tog TRACKBALL &kp SPACE &mkp MB4 &mkp MB5  &kp ENTER  &trans     &kp BSPC  &kp ESC
            >;
            sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
        };
    };
};
