/*
 * cocot46plus — Miryoku 42-key adaptation (Attempt 39)
 * Agen / Gloppy16/zmk-config
 *
 * Layout: Miryoku (github.com/manna-harbour/miryoku) derived — Colemak-DH
 * alphas, GACS home-row mods. Treated as a 42-key board (3x6 + 3 thumbs per
 * half): the two outermost bottom-row keys (old LGUI / old ESC) and the two
 * dedicated mouse-button keys are &none on every layer. Rev2 (Attempt 41):
 * the Mouse layer is GONE — the trackball pointer is always active at driver
 * level, and clicks live on the Macro layer. Space/Enter are plain taps
 * (never tap/hold muxed); layer switches are pure thumb holds.
 *
 * Layers: 0 Base, 1 Nav, 2 Num, 3 Sym, 4 Fun, 5 Macro, 6 Utility.
 * Access: hold 37=Macro, 38=Nav, 43=Sym, 44=Num; 39=Space / 42=Enter plain.
 *         Fun     = hold Sym (43) + Num-position (44) together.
 *         Utility = hold Macro (37) + Enter-position (42, &mo on Macro layer).
 * Scroll-wheel: driver scroll-layers = <1> (Nav only) in the overlay.
 *
 * Home-row mods use stock Miryoku ZMK values: flavor tap-preferred,
 * tapping-term 200 ms (u_mt), split left/right so opposite-hand chords work.
 *
 * MACROS: defined under "macros { ... }" below. To add one, copy an existing
 * node, change the label and bindings, then bind &your_label on the Macro
 * layer. Ctrl/Shift chords: macro_press ... macro_tap ... macro_release.
 *
 * Do not touch here: info.json (editor layout), conf files,
 * overlay scroll-layers = <1> (Nav) — bump it if a new scroll layer is added.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE    0
#define NAV     1
#define NUM     2
#define SYM     3
#define FUN     4
#define MACRO   5
#define UTILITY 6

/ {
    behaviors {
        /* Home-row mod hold-taps — Miryoku ZMK stock config (u_mt) */
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        /* ================= VS Code (left hand, Macro layer) ================= */

        /* Command palette: Ctrl+Shift+P */
        vs_cmd: vs_cmd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp P>
                , <&macro_release &kp LCTRL &kp LSHFT>
                ;
        };

        /* Save all: Ctrl+K S (chorded command) */
        vs_save_all: vs_save_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp K>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp S>
                ;
        };

        /* Toggle built-in terminal: Ctrl+` */
        vs_term: vs_term {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp GRAVE>
                , <&macro_release &kp LCTRL>
                ;
        };

        /* Format document: Shift+Alt+F */
        vs_fmt: vs_fmt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHIFT &kp LALT>
                , <&macro_tap &kp F>
                , <&macro_release &kp LSHIFT &kp LALT>
                ;
        };

        /* Quick open file: Ctrl+P */
        vs_open: vs_open {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp P>
                , <&macro_release &kp LCTRL>
                ;
        };

        /* ================= Blender (right hand, Macro layer) ================= */

        /* Save: Ctrl+S */
        bl_save: bl_save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp S>
                , <&macro_release &kp LCTRL>
                ;
        };

        /* Render image: F12 */
        bl_render: bl_render {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp F12>;
        };

        /* ================= FreeCAD (placeholders — remap to taste) ================= */

        /* New sketch: N, P sequence (placeholder) */
        fc_sketch: fc_sketch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp N &kp P>;
        };

        /* Pad: P, D sequence (placeholder) */
        fc_pad: fc_pad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp P &kp D>;
        };
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_0>;
    };

    keymap {
        compatible = "zmk,keymap";

        /* Physical grid: 12 / 12 / 12 / 10 bindings per layer.
           Bottom row = positions 36-45; 36 (old LGUI), 40+41 (old mouse
           buttons) and 45 (old ESC) are &none — the 42-key treatment. */

        base_layer {
            display-name = "Base";
            bindings = <
/* outer |        5-column Miryoku block        | outer */
&kp GRAVE   &kp Q    &kp W    &kp F    &kp P    &kp B    &kp J    &kp L    &kp U    &kp Y    &kp SQT   &kp BSLH
&kp ESC     &hml LGUI A    &hml LALT R    &hml LCTRL S    &hml LSHFT T    &kp G    &kp M    &hmr LSHFT N    &hmr LCTRL E    &hmr LALT I    &hmr LGUI O    &kp DEL
&kp TAB     &kp Z    &kp X    &kp C    &kp D    &kp V    &kp K    &kp H    &kp COMMA  &kp DOT  &kp FSLH  &none
/* thumbs: pure holds (Macro/Nav/Sym/Num) + plain Space/Enter taps — no
   tap/hold muxing on the thumbs; CAPS removed from bottom-outer (pos 30),
   it lives on the Utility layer now */
&none       &mo MACRO  &mo NAV  &kp SPACE  &none  &none  &kp RET  &mo SYM  &mo NUM  &none
            >;

            sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&none       &none  &none  &none  &none  &none    &kp K_AGAIN  &kp K_PASTE  &kp K_COPY  &kp K_CUT  &kp K_UNDO  &none
&kp LGUI    &kp LALT  &kp LCTRL  &kp LSHFT  &none   &none    &caps_word  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp RALT
&none       &none  &kp LALT  &kp LCTRL  &kp LSHFT  &none   &none    &kp INS  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END
&none       &trans  &trans  &kp RET  &none  &none  &kp BSPC  &kp DEL  &kp TAB  &none
            >;

            sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&none       &kp LBKT  &kp N7  &kp N8  &kp N9  &kp RBKT    &none  &none  &none  &none  &none  &none
&kp SEMI    &kp N4  &kp N5  &kp N6  &kp EQUAL  &none    &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&kp GRAVE   &kp N1  &kp N2  &kp N3  &kp BSLH  &none    &none  &none  &none  &none  &none  &none
&none       &kp DOT  &kp N0  &kp MINUS  &none  &none  &trans  &trans  &trans  &none
            >;

            sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&none       &kp LBRC  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RBRC    &none  &none  &none  &none  &none  &none
&kp COLON   &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS  &none    &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&kp TILDE   &kp EXCL  &kp AT  &kp HASH  &kp PIPE  &none    &none  &none  &none  &none  &none  &none
/* outer right thumb = &mo FUN: hold Sym (43) + Num-position (44) for Fun */
&none       &kp LPAR  &kp RPAR  &kp UNDER  &none  &none  &trans  &trans  &mo FUN  &none
            >;

            sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
&none       &kp F12  &kp F7  &kp F8  &kp F9  &kp PSCRN    &none  &none  &none  &none  &none  &none
&kp F11     &kp F4  &kp F5  &kp F6  &kp SLCK  &none    &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&kp F10     &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK  &none    &none  &none  &none  &none  &none  &none
&none       &kp K_APP  &trans  &kp TAB  &none  &none  &trans  &trans  &trans  &none
            >;

            sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
        };

        macro_layer {
            display-name = "Macro";
            bindings = <
&none       &vs_cmd  &vs_save_all  &vs_term  &vs_fmt  &vs_open    &bl_render  &bl_save  &fc_sketch  &fc_pad  &none  &none
&kp LGUI    &kp LALT  &kp LCTRL  &kp LSHFT  &none  &none    &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
/* clicks (30-33): pointer is always active at driver level — occasional
   LCLK / RCLK / MB4 / MB5 for when the trackball needs a button press */
&none       &bt BT_CLR  &rgb_ug RGB_TOG  &none  &none  &none    &mkp LCLK  &mkp RCLK  &mkp MB4  &mkp MB5  &none  &none
&none       &trans  &trans  &trans  &none  &none  &mo UTILITY  &trans  &trans  &none
            >;

            sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
        };

        utility_layer {
            display-name = "Utility";
            bindings = <
&none       &none  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI    &rgb_ug RGB_BRD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_EFR  &none  &none
&none       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none    &kp CAPS  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&none       &bt BT_CLR  &bt BT_CLR_ALL  &ext_power EP_TOG  &out OUT_TOG  &rgb_ug RGB_TOG    &none  &none  &none  &none  &none  &none
&none       &trans  &trans  &kp K_APP  &none  &none  &trans  &sys_reset  &bootloader  &none
            >;

            sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
        };
    };
};
